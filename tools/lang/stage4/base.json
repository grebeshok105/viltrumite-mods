{
 "ability.viltrumitecore.ironman_veronica.name": {
  "en_us": "<gold>Veronica"
 },
 "ability.viltrumitecore.ironman_veronica.desc": {
  "en_us": "<grey>Type: <aqua>Press\n\n<grey>Calls the Veronica pod: it falls from the sky\n<grey>within 30 blocks (never into water), ~1 TNT.\n<grey>Press again while it stands (up to 64 blocks):\n<grey>the suit menu. The pod stays ~60 s.\n<grey>Cooldown 3 min after it leaves.\n\n<blue>Iron Man"
 },
 "mark.viltrumitecore.mark_7.name": {
  "en_us": "Mark 7"
 },
 "mark.viltrumitecore.mark_7.role": {
  "en_us": "Universal"
 },
 "mark.viltrumitecore.mark_7.signature": {
  "en_us": "Micro-lasers"
 },
 "mark.viltrumitecore.mark_7.desc": {
  "en_us": "<grey>RMB (via MMB) or slot 3: thin precise beam\n<grey>from the forearms. One target, breaks shields."
 },
 "mark.viltrumitecore.mark_42.name": {
  "en_us": "Mark 42"
 },
 "mark.viltrumitecore.mark_42.role": {
  "en_us": "Modular"
 },
 "mark.viltrumitecore.mark_42.signature": {
  "en_us": "Rocket fist"
 },
 "mark.viltrumitecore.mark_42.desc": {
  "en_us": "<grey>The glove flies to the target, hits and returns.\n<grey>Loses parts one by one as it breaks."
 },
 "mark.viltrumitecore.mark_15.name": {
  "en_us": "Mark 15 «Sneaky»"
 },
 "mark.viltrumitecore.mark_15.role": {
  "en_us": "Stealth"
 },
 "mark.viltrumitecore.mark_15.signature": {
  "en_us": "Camouflage"
 },
 "mark.viltrumitecore.mark_15.desc": {
  "en_us": "<grey>~8 s of refraction camo: mobs beyond 8 blocks\n<grey>lose you, the first hit deals x2.\n<grey>Hidden from focus and scans, silent flight."
 },
 "mark.viltrumitecore.mark_39.name": {
  "en_us": "Mark 39 «Starboost»"
 },
 "mark.viltrumitecore.mark_39.role": {
  "en_us": "Speed"
 },
 "mark.viltrumitecore.mark_39.signature": {
  "en_us": "Starboost"
 },
 "mark.viltrumitecore.mark_39.desc": {
  "en_us": "<grey>Back booster: instant dash to sonic speed\n<grey>in any direction, also a vertical take-off.\n<grey>Fastest mark, cheaper sonic, weaker weapons."
 },
 "mark.viltrumitecore.mark_17.name": {
  "en_us": "Mark 17 «Heartbreaker»"
 },
 "mark.viltrumitecore.mark_17.role": {
  "en_us": "Unibeam"
 },
 "mark.viltrumitecore.mark_17.signature": {
  "en_us": "Pulse Unibeam"
 },
 "mark.viltrumitecore.mark_17.desc": {
  "en_us": "<grey>Three short strong Unibeam pulses, no overheat.\n<grey>The normal Unibeam charges in 0.5 s."
 },
 "mark.viltrumitecore.war_machine_mk2.name": {
  "en_us": "War Machine Mk2"
 },
 "mark.viltrumitecore.war_machine_mk2.role": {
  "en_us": "Missiles"
 },
 "mark.viltrumitecore.war_machine_mk2.signature": {
  "en_us": "Shoulder gun"
 },
 "mark.viltrumitecore.war_machine_mk2.desc": {
  "en_us": "<grey>Hold: bursts at the crosshair target, energy\n<grey>instead of ammo. Up to 8 missile marks.\n<grey>Slower flight, sonic drains faster."
 },
 "mark.viltrumitecore.iron_heart_mk3.name": {
